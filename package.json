{
  "name": "ticket-window",
  "version": "0.11.1",
  "private": true,
  "description": "本地官方购票流程辅助工具",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "start": "pnpm build && electron .",
    "dev": "pnpm build && electron .",
    "web": "vite --host 127.0.0.1 --open",
    "web:preview": "vite preview --host 127.0.0.1 --open",
    "test:web": "node tests/web.cjs",
    "build": "tsc -p tsconfig.electron.json && tsc -p tsconfig.json && vite build",
    "test": "vitest run",
    "test:ui": "pnpm build && node tests/smoke.cjs",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.json --noEmit",
    "format:check": "prettier --check src electron shared tests vite.config.mts",
    "dist": "pnpm build && electron-builder --win nsis"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.9",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^4.0.0"
  },
  "build": {
    "appId": "com.ticketwindow.desktop",
    "productName": "候票台",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.ico",
      "node_modules/sql.js/dist/sql-asm.js",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
